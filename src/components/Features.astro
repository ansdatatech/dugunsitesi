---
// src/components/Features.astro
// İkonların arka plan (bgClass) ve yazı rengini (textClass) özelleştirdik
const features = [
  {
    title: "Akıllı LCV Yönetimi",
    description: "Kim geliyor, kim çocuk getiriyor karmaşasına son.",
    bgClass: "bg-blue-50",
    textClass: "text-blue-500",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  },
  {
    title: "Ortak Fotoğraf Havuzu",
    description: "Masalardaki QR kodu okutan misafirleriniz, anıları doğrudan yüklesin.",
    bgClass: "bg-rose-50",
    textClass: "text-rose-500",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`
  },
  {
    title: "Çifte Özel Alan Adı",
    description: "Sadece size özel bir web adresiyle davetiyenizi prestijli hale getirin.",
    bgClass: "bg-amber-50",
    textClass: "text-amber-500",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>`
  },
  {
    title: "Çevre Dostu & Ekonomik",
    description: "Matbaa ve kargo masraflarını bitirin, doğayı koruyun.",
    bgClass: "bg-emerald-50",
    textClass: "text-emerald-500",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064" /></svg>`
  }
];
---

<section id="ozellikler" class="py-20 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-stone-900 sm:text-4xl">Neden Dijital Davetiye?</h2>
      <p class="mt-4 text-lg text-stone-600">Geleneksel davetiyelerin ötesinde, sürecinizi renklendiren çözümler.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {features.map((feature) => (
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-stone-100 hover:shadow-md transition duration-300 group">
          <!-- İkon arka planı dinamik olarak değişiyor -->
          <div class={`w-14 h-14 ${feature.bgClass} ${feature.textClass} rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300`}>
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="text-xl font-semibold text-stone-900 mb-2">{feature.title}</h3>
          <p class="text-stone-600 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>