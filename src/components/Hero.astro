---
// src/components/Hero.astro
---

<section class="relative pt-24 pb-32 overflow-hidden bg-gradient-to-br from-rose-50 via-white to-orange-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    
    <h1 class="text-5xl md:text-6xl font-bold text-stone-900 tracking-tight mb-6">
      En Özel Gününüzü <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-orange-500">Dijitale</span> Taşıyın.
    </h1>
    
    <p class="mt-4 max-w-2xl text-lg text-stone-600 mx-auto mb-10">
      Davetiye masraflarından kurtulun, misafir katılımlarını anlık takip edin ve 
      tüm düğün fotoğraflarınızı misafirlerinizle ortak bir dijital albümde toplayın.
    </p>
    
    <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
      <!-- Ana buton: Canlı gradient ve hover (üzerine gelince büyüme ve parlama) efekti eklendi -->
      <a href="#demos" class="w-full sm:w-auto bg-gradient-to-r from-rose-500 to-orange-500 text-white px-8 py-3 rounded-full font-medium hover:scale-105 hover:shadow-lg hover:shadow-rose-500/30 transition-all duration-300">
        Demo Siteleri İncele
      </a>
      <!-- İkincil buton: Sade ve şık -->
      <a href="#iletisim" class="w-full sm:w-auto bg-white text-stone-800 border border-stone-200 px-8 py-3 rounded-full font-medium hover:bg-stone-50 hover:border-stone-300 transition-all duration-300">
        Bize Ulaşın
      </a>
    </div>

  </div>
  
  <!-- Arka plan dekoratif yumuşak renk ışıkları -->
  <div class="absolute top-0 left-0 w-64 h-64 bg-rose-100 rounded-full mix-blend-multiply filter blur-3xl opacity-50 translate-x-[-50%] translate-y-[-50%]"></div>
  <div class="absolute bottom-0 right-0 w-80 h-80 bg-orange-100 rounded-full mix-blend-multiply filter blur-3xl opacity-50 translate-x-[30%] translate-y-[30%]"></div>
</section>