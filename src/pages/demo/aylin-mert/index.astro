---
// src/pages/demo/aylin-mert/index.astro
import '../../../styles/global.css';
---

<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aylin & Mert | Evleniyoruz</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400&display=swap" rel="stylesheet">
  
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-editorial { font-family: 'Cormorant Garamond', serif; }
    
    /* Scroll Animasyonları */
    .reveal { opacity: 0; transform: translateY(30px); transition: all 1.2s cubic-bezier(0.2, 0.8, 0.2, 1); }
    .reveal.active { opacity: 1; transform: translateY(0); }
    .hidden-mode { display: none !important; }
  </style>
</head>
<body class="bg-white text-[#1a1a1a] antialiased selection:bg-gray-200">

  <!-- PRELOADER (Minimalist) -->
  <div id="preloader" class="fixed inset-0 z-[100] bg-white flex items-center justify-center transition-opacity duration-1000">
    <div class="font-editorial text-5xl tracking-[0.5em] font-light">A & M</div>
  </div>

  <!-- ARKA PLAN MÜZİĞİ (Akustik/Piyano) -->
  <audio id="bgMusic" loop src="https://cdn.pixabay.com/audio/2022/05/16/audio_2d13b288e0.mp3"></audio>
  <button id="musicBtn" class="fixed bottom-6 right-6 z-50 border border-stone-200 bg-white p-3 rounded-full hover:bg-stone-50 transition">
    <svg class="w-5 h-5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"></path></svg>
  </button>

  <!-- ZAMAN MAKİNESİ BUTONU -->
  <button id="timeMachineBtn" class="fixed bottom-6 left-6 z-50 bg-white text-stone-900 border border-stone-200 px-6 py-3 text-[10px] tracking-widest uppercase hover:bg-stone-900 hover:text-white transition">
    <span id="btnText">Düğün Sonrasına Git</span>
  </button>

  <!-- KAHRAMAN ALANI -->
  <section class="h-screen flex flex-col items-center justify-center relative px-6 reveal">
    <h1 class="font-editorial text-7xl md:text-9xl font-light tracking-wider mb-2 text-stone-900">Aylin & Mert</h1>
    <p id="heroSubtitle" class="tracking-[0.4em] text-xs md:text-sm uppercase text-stone-400 mt-8 font-light transition-all">
      24 Eylül 2026 &nbsp; &bull; &nbsp; İstanbul
    </p>
    
    <div class="absolute bottom-12 left-1/2 transform -translate-x-1/2 flex flex-col items-center reveal delay-300">
      <span class="text-[10px] uppercase tracking-widest text-stone-400 mb-4">Aşağı Kaydırın</span>
      <div class="w-[1px] h-16 bg-stone-300"></div>
    </div>
  </section>

  <!-- ============================================== -->
  <!-- FAZ 1: DÜĞÜN ÖNCESİ (TAM SÜRÜM)               -->
  <!-- ============================================== -->
  <div id="preWeddingMode">
    <!-- Program -->
    <section class="py-32 px-6 max-w-4xl mx-auto reveal">
      <h2 class="font-editorial text-4xl text-center mb-20 text-stone-900">Program</h2>
      
      <div class="space-y-0">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-t border-stone-200 py-10 group hover:bg-stone-50 transition-colors px-4 -mx-4">
          <div class="mb-4 md:mb-0">
            <h3 class="font-editorial text-3xl mb-1">Karşılama & Kokteyl</h3>
            <p class="text-stone-400 text-sm font-light">Saat 18:00</p>
          </div>
          <div class="text-left md:text-right">
            <p class="text-sm tracking-wide text-stone-800">Sakıp Sabancı Müzesi</p>
            <p class="text-xs text-stone-400 mt-1 font-light">Emirgan, İstanbul</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-t border-stone-200 py-10 group hover:bg-stone-50 transition-colors px-4 -mx-4">
          <div class="mb-4 md:mb-0">
            <h3 class="font-editorial text-3xl mb-1">Nikah Merasimi</h3>
            <p class="text-stone-400 text-sm font-light">Saat 19:30</p>
          </div>
          <div class="text-left md:text-right">
            <p class="text-sm tracking-wide text-stone-800">Fıstıklı Teras</p>
            <p class="text-xs text-stone-400 mt-1 font-light">Emirgan, İstanbul</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-t border-b border-stone-200 py-10 group hover:bg-stone-50 transition-colors px-4 -mx-4">
          <div class="mb-4 md:mb-0">
            <h3 class="font-editorial text-3xl mb-1">Akşam Yemeği</h3>
            <p class="text-stone-400 text-sm font-light">Saat 20:30</p>
          </div>
          <div class="text-left md:text-right">
            <p class="text-sm tracking-wide text-stone-800">Müze Restoranı</p>
            <p class="text-xs text-stone-400 mt-1 font-light">Emirgan, İstanbul</p>
          </div>
        </div>
      </div>
    </section>

    <!-- LCV -->
    <section class="py-32 bg-[#F9F9F9] px-6 text-center reveal">
      <div class="max-w-xl mx-auto">
        <h2 class="font-editorial text-4xl mb-6 text-stone-900">Lütfen Yanıtlayın</h2>
        <p class="text-stone-500 text-sm mb-12 font-light leading-relaxed">
          Bu özel günümüzde yanımızda olmanızdan mutluluk duyacağız. Organizasyon detayları için lütfen <strong>1 Eylül 2026</strong> tarihine kadar katılım durumunuzu bildiriniz.
        </p>
        <button class="border border-stone-900 text-stone-900 hover:bg-stone-900 hover:text-white px-12 py-4 text-xs tracking-[0.2em] uppercase transition-all duration-500">
          LCV Formu
        </button>
      </div>
    </section>
  </div>


  <!-- ============================================== -->
  <!-- FAZ 2: DÜĞÜN SONRASI (TAM SÜRÜM)               -->
  <!-- ============================================== -->
  <div id="postWeddingMode" class="hidden-mode">
    <section class="py-20 px-6 text-center reveal">
      <h2 class="font-editorial text-4xl mb-4 text-stone-900">Bir Ömür Boyu</h2>
      <p class="text-stone-500 text-sm mb-10 font-light max-w-md mx-auto">Günün en güzel anlarını bizimle paylaştığınız için teşekkür ederiz.</p>
      
      <!-- Minimalist Fotoğraf Yükleme Butonu -->
      <button class="border border-stone-900 text-stone-900 hover:bg-stone-900 hover:text-white px-10 py-4 text-xs tracking-[0.2em] uppercase transition-all duration-500 inline-flex items-center gap-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
        <span>Kendi Objektifinizden Fotoğraf Ekleyin</span>
      </button>
    </section>

    <!-- Galeri (Asimetrik) -->
    <section class="max-w-6xl mx-auto px-6 pb-32 reveal">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <img src="https://placehold.co/600x800/eeeeee/666666?text=Ani+1" class="w-full h-[30rem] object-cover grayscale hover:grayscale-0 transition duration-700">
        <div class="flex flex-col gap-8 md:mt-20">
          <img src="https://placehold.co/600x600/eeeeee/666666?text=Ani+2" class="w-full h-64 object-cover grayscale hover:grayscale-0 transition duration-700">
          <p class="font-editorial text-2xl text-center italic text-stone-500">"Sonsuzluk..."</p>
        </div>
        <img src="https://placehold.co/600x800/eeeeee/666666?text=Ani+3" class="w-full h-[30rem] object-cover grayscale hover:grayscale-0 transition duration-700">
      </div>
    </section>

    <!-- Ziyaretçi Defteri -->
    <section class="py-32 bg-[#F9F9F9] px-6 reveal">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-editorial text-3xl mb-16 text-center text-stone-900">Ziyaretçi Defteri</h2>
        
        <div class="space-y-12">
          <div class="border-l border-stone-300 pl-8">
            <p class="text-stone-600 font-light leading-relaxed mb-4">"Her detayıyla mükemmel, bir o kadar da zarif bir gündü. Hep çok mutlu olun."</p>
            <span class="text-xs tracking-widest uppercase text-stone-400">Can & Eda</span>
          </div>
          <div class="border-l border-stone-300 pl-8">
            <p class="text-stone-600 font-light leading-relaxed mb-4">"Tıpkı sizin gibi sade ve unutulmaz bir nikah töreni oldu. Sevginiz daim olsun."</p>
            <span class="text-xs tracking-widest uppercase text-stone-400">Selin Yılmaz</span>
          </div>
        </div>

      </div>
    </section>
  </div>

  <script>
    // PRELOADER
    window.addEventListener('load', () => setTimeout(() => {
      const p = document.getElementById('preloader'); p.style.opacity = '0'; setTimeout(() => p.remove(), 1000);
    }, 1500));

    // MÜZİK
    const mBtn = document.getElementById('musicBtn'); const bgM = document.getElementById('bgMusic');
    let isP = false; mBtn.addEventListener('click', () => { isP ? bgM.pause() : bgM.play(); isP = !isP; });

    // ZAMAN MAKİNESİ
    let isPost = false;
    document.getElementById('timeMachineBtn').addEventListener('click', () => {
      isPost = !isPost;
      document.getElementById('preWeddingMode').classList.toggle('hidden-mode');
      document.getElementById('postWeddingMode').classList.toggle('hidden-mode');
      document.getElementById('btnText').innerText = isPost ? "Düğün Öncesine Dön" : "Düğün Sonrasına Git";
      document.getElementById('heroSubtitle').innerText = isPost ? "Teşekkür Ederiz" : "24 Eylül 2026 • İstanbul";
      setTimeout(() => { window.scrollTo({ top: 0, behavior: 'smooth' }); initAnimations(); }, 100);
    });

    // SCROLL
    function initAnimations() {
      const obs = new IntersectionObserver(e => e.forEach(en => { if(en.isIntersecting) en.target.classList.add('active'); }), { threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach(r => { r.classList.remove('active'); obs.observe(r); });
    }
    window.addEventListener('DOMContentLoaded', initAnimations);
  </script>
</body>
</html>